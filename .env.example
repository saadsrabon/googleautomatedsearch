DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# browser (Puppeteer) or cse (Google Custom Search API)
SEARCH_PROVIDER=browser
PUPPETEER_HEADLESS=false
CAPTCHA_MANUAL_WAIT=true
CAPTCHA_WAIT_TIMEOUT_MS=600000
PUPPETEER_USER_DATA_DIR=.puppeteer-profile

# Only if SEARCH_PROVIDER=cse
GOOGLE_API_KEY=""
GOOGLE_CSE_ID=""

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.2-3b-instruct:free"

# Delay between each OpenRouter call (ms)
AI_ITEM_DELAY_MS=400
